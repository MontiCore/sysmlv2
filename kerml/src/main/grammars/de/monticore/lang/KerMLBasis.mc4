package de.monticore.lang;

// TODO Ziel für beinhaltete Elemente: Nur, was absolut nötig ist, dh. keine
//  Overrides von existierenden Regeln (zB Modifier). Stattdessen die Overrides
//  in KerML.mc4 machen. Die existierenden Regeln bzw deren Grammatik (zB
//  UML-Modifier) dort importieren, wo unbedingt gebraucht (zB in Elements (ehem
//  Types), da diese die Regel "Modifier" benötigen.
component grammar KerMLBasis
    extends de.monticore.MCBasics,
            de.monticore.types.MCBasicTypes,
            de.monticore.UMLModifier
{
    // TODO nach Elements schieben
    PackageDeclaration implements KerMLElement=
        Modifier  ("standard")? ("library")? "package" MCQualifiedName
        ( "{" (KerMLElement)* "}");

    // TODO Verschieben nach Elements (ehem. Types)
    // Handels import statements
    ImportStatement implements KerMLElement =
        // Hier unbedingt SysML-Original kopieren, so gut es geht und so weit es
        // nötig ist.
        Modifier "import" MCQualifiedName ("::" "*")? ";";

    /* Matches anything except a single quote */
    fragment token Anything = ~ ('\'') ;

    interface KerMLElement;

    interface IFeatureBlock;
    interface IFunctionBlock;
    interface FeatureInit;

    KerMLQualifiedFunctionName = FunctionName ("::" FunctionName)*;
    FunctionName = MCQualifiedName;
}
