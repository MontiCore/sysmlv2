/* (c) https://github.com/MontiCore/monticore */
package de.monticore.lang;

component grammar KerMLElements
    extends KerMLBasis,
            de.monticore.types.MCBasicTypes,
            de.monticore.symbols.BasicSymbols,
            de.monticore.UMLModifier,
            de.monticore.Cardinality  // Cardinality
{
  DocBlock implements KerMLElement = "doc";

  symbol scope PackageDeclaration implements KerMLElement =
      Modifier "standard"? "library"? "package" name:Name
      ("{" KerMLElement* "}");

  KerMLImportStatement extends MCImportStatement implements KerMLElement =
      Modifier "import" ["all"]? MCQualifiedName
      (("::" | ".") (Star:["*"] | Recursive:["**"]))*
      ("[" filter:Expression "]")?
      ("as" Name)?
      ("{" KerMLElement* "}" | ";");

  symbol scope Datatype implements KerMLElement =
      Modifier "datatype" name:Name KerMLRelationClause*
      ("{" KerMLElement* "}" | ";");

  Classifier implements KerMLElement =
      Modifier
      ("class" | "classifier" | "subclassifier" | "predicate") "all"?
      MCQualifiedName MultiplicityBounds?
      KerMLRelationClause*
      ("{" KerMLElement* "}" | ";");

  symbol scope Feature implements KerMLElement =
      Modifier "feature" KerMLIdentifier? Name?
      MultiplicityPart? Specialization*
      ("chains" MCQualifiedName)?
      DefaultValue?
      ("{"
        KerMLElement*
      "}" | ";");

  KerMLIdentifier = "<" Name ">";

  interface Specialization = superTypes:MCType+;

  KerMLTyping implements Specialization =
      (":" | "typed by") superTypes:(MCType || ",")+ MultiplicityPart?;

  KerMLFeatureSubsetting implements Specialization =
      (":>" | "subsets") superTypes:(MCType || ",")+;

  KerMLFeatureRedefinition implements Specialization =
      (":>>" | "redefines") superTypes:(MCType || ",")+;

  KerMLFeatureCrossing implements Specialization =
      "crosses" superTypes:(MCType || ",")+;

  KerMLFeatureReferences implements Specialization =
      "references" superTypes:(MCType || ",")+;

  MultiplicityPart =
      Cardinality (["ordered"] | ["nonunique"])*
      | (["ordered"] | ["nonunique"])+;

  MultiplicityBounds extends Cardinality =
      "["
      (many:["*"] | lowerBoundLit:NatLiteral | lowerExpr:Expression)
      (".." (upperBoundLit:NatLiteral | noUpperLimit:["*"] | upperExpr:Expression))?
      "]";

  DefaultValue =
      [default1:"default"]? ([binding:"="] | [initial:":="]) Expression
      | [default2:"default"] Expression;

  symbolrule Feature =
      types: de.monticore.types.check.SymTypeExpression* ;

  Multiplicity implements KerMLElement =
      "multiplicity"
      MCQualifiedName
      MultiplicityBounds
      ("{" KerMLElement* "}");

  Struct implements KerMLElement =
      Modifier
      "struct" "all"? Name (MultiplicityBounds | KerMLRelationClause)*
      (Name MultiplicityBounds? ("," Name MultiplicityBounds*)*)?
      ("{" KerMLElement* "}" | ";");

  Behavior implements KerMLElement =
      Modifier ("behavior" | "interaction") "all"? MCQualifiedName
      KerMLRelationClause*
      ("{" KerMLElement* "}" | ";");

  Implies implements KerMLElement =
      left:Expression "implies" right:Expression;

  KerMLFunction implements KerMLElement =
      Modifier "function" MCQualifiedName
      KerMLRelationClause?
      ("{"
        KerMLElement*
        Expression?
      "}" | ";");

  KerMLExpressionDeclaration implements KerMLElement =
      Modifier "expr" KerMLIdentifier? Name?
      MultiplicityPart? Specialization* DefaultValue?
      ("{" KerMLElement* Expression? "}" | ";");

  FunctionParameter implements KerMLElement =
      Modifier
      KerMLRedefinition?
      name:MCQualifiedName*
      (":" type:MCQualifiedName)?
      (MultiplicityPart | KerMLSubsetting
        | KerMLChains | KerMLRedefinition)*
      (DefaultValue | Expression)?
      (("{" (KerMLElement | Expression)* "}")+ | ";");

  FunctionReturn implements KerMLElement =
      "return" Name? (":" type:MCQualifiedName)?
      (MultiplicityPart | KerMLRelationClause)*
      (("=" | "default") Expression)?
      ("{" KerMLElement* "}" | ";");

  IfElse implements KerMLElement =
      "if" condition:Expression "?" if:Expression "else" else:Expression;

  Invariant implements KerMLElement =
      Modifier "inv" MCQualifiedName? "{" (KerMLElement | Expression)* "}";

  Connector implements KerMLElement =
      Modifier
      "connector" "all"? MCQualifiedName?
      KerMLRelationClause*
      (":" type:MCQualifiedName)?
      MultiplicityPart?
      KerMLRelationClause*
      (
        "from"? MultiplicityPart? Expression
        ("references" fromRef:MCQualifiedName)?
        "to" MultiplicityPart? Expression
        ("references" toRef:MCQualifiedName)?
      )?
      ("{" KerMLElement* "}" | ";");

  Step implements KerMLElement =
      Modifier "composite"? "step"
      KerMLIdentifier? Name? MultiplicityPart?
      Specialization* DefaultValue?
      ("{" KerMLElement* "}" | ";");

  Metaclass implements KerMLElement =
      Modifier "metaclass" MCQualifiedName
      KerMLSpecialization?
      ("{" KerMLElement* "}" | ";");

  Association implements KerMLElement =
      Modifier
      "assoc" "struct"? "all"? MCQualifiedName MultiplicityPart?
      KerMLRelationClause*
      ("{" KerMLElement* "}" | ";");

  CommentElement implements KerMLElement =
      "comment" MCQualifiedName?
      ("about" MCQualifiedName ("," MCQualifiedName)*)?
      ("{" KerMLElement* "}" | ";")?;

  Succession implements KerMLElement =
      Modifier "succession" "all"? (Name MultiplicityPart?)? ()
      ("first"? MultiplicityPart? left:Expression)?
      "then"
      MultiplicityPart? right:Expression
      ("{" KerMLElement* "}" | ";");

  Binding implements KerMLElement =
      Modifier "binding" (Name MultiplicityPart? "of"?)?
      MultiplicityPart? left:Expression "="
      MultiplicityPart? right:Expression
      ("{" KerMLElement* "}" | ";");

  Alias implements KerMLElement =
      Modifier "alias" MCQualifiedName "for" MCQualifiedName ";";

  NamelessRedefinitionFeature implements KerMLElement =
      Modifier "feature" KerMLRedefinition ";";

  ShorthandRedefinition implements KerMLElement =
      ":>>" Name "=" Expression ";";

  BodyRelationStatement implements KerMLElement =
      Modifier KerMLRelationClause*
      ("{" KerMLElement* "}" | ";");

  interface KerMLRelationClause;

  KerMLSpecialization implements KerMLRelationClause =
      (":>" | "specializes") specialized:(MCQualifiedName || ",")+;

  KerMLSubsetting implements KerMLRelationClause =
      (":>" | "subsets") subset:(MCQualifiedName || ",")+;

  KerMLRedefinition implements KerMLRelationClause =
      (":>>" | "redefines") redefined:(MCQualifiedName || ",")+;

  KerMLChains implements KerMLRelationClause =
      (":>" | "chains") chained:(MCQualifiedName || ",")+;

  KerMLCrossing implements KerMLRelationClause =
      "crosses" MCQualifiedName ("," MCQualifiedName)*;

  KerMLIntersection implements KerMLRelationClause =
      "intersects" MCQualifiedName ("," MCQualifiedName)*;

  KerMLInverse implements KerMLRelationClause =
      "inverse" "of"? inverses:(MCQualifiedName || ",")+;

  KerMLUnion implements KerMLRelationClause =
      "unions" unioned:(MCQualifiedName || ",")+;

  KerMLDisjoint implements KerMLRelationClause =
      "disjoint" "from" disjoints:(MCQualifiedName || ",")+;

  DisjointStatement implements KerMLElement =
      Modifier "disjoint" left:MCQualifiedName "from"
      right:(MCQualifiedName || ",")+ ";";

  KerMLReferences implements KerMLRelationClause =
      "references" referenced:(MCQualifiedName || ",")+;
}
