package de.monticore.lang;


// TODO Ziel bei Imports:
// Basis importiert möglichst wenig aus MontiCore
// Elements (ehem. Types) basieren nur auf Basis und eventuell weiteren MC-Grammatiken
// Expressions basieren nur aus ExpressionBasis, wenn absolut nicht zu vermeiden, dann auch auf Basis
// Diese Grammatik hier importier Basis, Expressions, Elements (ehem Types)
grammar KerML
  extends KerMLExpressions
{

  // TODO Rename KerMLModel
  start KerMLModel;

  // TODO: KerMLModel = KerMLElement*; (wie in der SysML)
  KerMLModel = PackageDeclaration;

  @Override
  token Name =
    ( ( 'a'..'z' | 'A'..'Z' | '_' | '$' )
      ( 'a'..'z' | 'A'..'Z' | '_' | '0'..'9' | '$' )* )
    | ( '\'' Anything* '\'' ) :
    {
      if(getText().length() > 0 && getText().charAt(0) == '\'')
        setText(getText().substring(1, getText().length() - 1));
    } ;

    @Override
        Modifier =
            Stereotype?
            (   ["public"]       | [public:"+"]
                | ["private"]      | [private:"-"]
                | ["protected"]    | [protected:"#"]
                | ["final"]
                | ["abstract"]
                | ["local"]
                | ["derived"]      | [derived:"/"]
                | ["readonly"]     | [readonly:"?"]
                | ["static"]
                | ["in"] | ["out"] | ["inout"]        // default direction is "in"
                | ["end"]
                | ["ref"]
                | ["return"]                          // only in calculation, analysis, verification, function
                | ["timeslice"]                       // only in occurrences
                | ["snapshot"]                        // only in occurrences
                | ["individual"]                      // only in occurrences
                | ["event"]                           // only in occurrences
                | ["variation"]
                | ["variant"]
                | ["member"]
            )*;

  KerMLQualifiedName extends MCQualifiedName = parts:Name (("::"|".") parts:Name)*;
}
