package de.monticore.lang;

grammar KerML extends de.monticore.MCBasics {

  start KerMLDocument;

  KerMLDocument = DataType;

  DataType =
    ("abstract")?
    "datatype"
    Name
    "{"
    (Feature)* "}";

  Feature =
    "feature"
    Name
    (Multiplicity)?
    ("nonunique")?
    ";";

  Multiplicity =
    "["
    min:Bound
    ".."
    max:Bound
    "]";

  Bound =
    Number | "*" | Name ;

  token Number = ( '0'..'9')+;
}
