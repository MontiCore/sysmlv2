/* (c) https://github.com/MontiCore/monticore */
package de.monticore.lang;

component grammar KerMLTypes
    extends KerMLBase,
            de.monticore.literals.MCCommonLiterals,
            de.monticore.expressions.ExpressionsBasis
{
    /*
        Implementation of PackageElements like datatypes, classifiers and features
    */
    Datatype implements PackageElement =
        DatatypeHead ("{" (DocBlock|PackageElement)* "}" | ";");

    DatatypeHead =
        ("abstract")? "datatype" Name
        ((":>" | "specializes") superTypes:KerMLQualifiedName ("," superTypes:KerMLQualifiedName)*)?
        ("intersects" intersectTypes:KerMLQualifiedName ("," intersectTypes:KerMLQualifiedName)*)?;

    Classifier implements PackageElement =
        ("abstract") ? ("classifier") Name
        ("{" (DocBlock|PackageElement)* "}");

    Feature implements PackageElement =
        Modifier?
        ("abstract")?
        ("var")?
        "feature" Name
        (":" type:KerMLQualifiedName)?
        (TypeMultiplicity)?
        ("ordered")?
        ("nonunique")?
        ("subsets" subsets:KerMLQualifiedName ("," subsets:KerMLQualifiedName)*)?
        ("chains" chains:KerMLQualifiedName ("," chains:KerMLQualifiedName)*)?
        ((":>>"| "redefines") redefined:KerMLQualifiedName ("," redefined:KerMLQualifiedName)*)?
        ("{" (DocBlock|PackageElement)* "}");

    Multiplicity implements PackageElement =
        MultiplicityHead
        ("{" (DocBlock)? "}");

    MultiplicityHead =
        "multiplicity"
        Name
        TypeMultiplicity;

    Function implements PackageElement =
        Modifier?
        ("abstract")? "function" FunctionName
        ("specializes" superFunctions:QualifiedFunctionName ("," superFunctions:QualifiedFunctionName)*)?
        "{" FunctionBody "}";

    Struct implements PackageElement =
        Modifier?
        ("abstract")?
        "struct" StructName "{" StructBody? "}";

    Behavior implements PackageElement =
        BehaviorHead "{" BehaviorBody "}";

    BehaviorHead =
        "behavior" Name "specializes" Name;

    BehaviorBody = "test";

    StructName =
        Name (TypeMultiplicity)? (":>" | ":")? ((Name (TypeMultiplicity)?) ("," Name (TypeMultiplicity)*)*)?;

    StructBody =
        (DocBlock)?
        (StructVar | StructInv | Feature)* ;

    StructVar =
        Modifier?
        Name
        ":"
        (Name)?
        (":>>" Name)? ";";

    StructInv =
        "inv"
        Name?
        "{" (DocBlock|PackageElement)? "}";


    FunctionBody =
        ((FunctionParameter|TypeFeature|Function|IfElse |FunctionReturn| Invariant|DocBlock)*)? ("chain")?;

    FunctionParameter =
        ("in") (FunctionName|Char)* ":"? (FunctionBlock)* Name? TypeMultiplicity? ("ordered")? ("nonunique")? ("chain")?(FunctionParameter|";")*;

    FunctionBlock = "{"(FunctionReturn)* "}";

    FunctionReturn =
        "return" ":"? Name TypeMultiplicity? ("ordered")? ("nonunique")?
        ("=" | "default")?  (Expression | FunctionCall | IfElse)? EscapedName? "#"? "??"? "(index)"? Name? ";" ;

    FunctionCall = (QualifiedFunctionName? "(" (Expression ("," Expression)*)?")");

    KerMLAsExpression implements Expression =
        Expression "as" KerMLQualifiedName;

    FunctionName = Name | EscapedName | SpecialName;

    SpecialName = "test" | "expr" | "thenValue"| "null";

    token EscapedName = "\'"(Name | "==" | "!=" | "===" | "[" | "!==" | "#" | "," | "@" | "@@" | "|" 
    | "&" | "array#" | "+" | "-" | "*" | "/" | "**" | "^" | "==" | "." | "??" | "%" | "~" | "<" | ">"
    | "<=" | ">=" | "..")"\'";

    QualifiedFunctionName = FunctionName ("::" FunctionName)*;

    TypeFeature implements PackageElement =
        Modifier?
        "feature" 
        ( "step" | "chain")?
        ("chains")?
        (":>>")?
        KerMLQualifiedName
        (":" type:KerMLQualifiedName)?
        (TypeMultiplicity)?
        ("ordered")?
        ("nonunique")?
        ("subsets" subsets:KerMLQualifiedName ("," subsets:KerMLQualifiedName)*)?
        ("chains" chains:KerMLQualifiedName ("," chains:KerMLQualifiedName)*)?
        ((":>>"| "redefines") redefined:KerMLQualifiedName ("," redefined:KerMLQualifiedName)*)?
        (FeatureInit | ";");

    interface FeatureInit;

    FeatureBlock implements FeatureInit = "{" (DocBlock|PackageElement)* "}";

    TypeMultiplicity = "[" min:Bound ".." max:Bound "]" | "[" exact:Bound "]";

    Bound = NatLiteral | "*" | Name;

    IfElse =
        "if" IfElsePart "?" IfElsePart "else" IfElsePart;

    IfElsePart = IfElseElement+ ;

    IfElseElement =
          Name | NatLiteral | "null" | "in" | "or" | "and" | "as"
        | "#" | "*" | "+" | "-" | "." | "," | ":" | "=" | "==" | "!=" | "<" | ">" | "<=" | ">=" | "!" | "->" | ".."
        | "(" (IfElseElement | ";")* ")"
        | "{" (IfElseElement | ";")* "}"
        | "[" (IfElseElement | ";")* "]" ;

    Invariant implements PackageElement =
        "inv" MCQualifiedName? "{" MCQualifiedName? Expression "}";
}
