package de.monticore.lang;

component grammar KerMLTypes
    extends KerMLBase,
            de.monticore.literals.MCCommonLiterals,
            de.monticore.expressions.ExpressionsBasis
{
    @Override
    KerMLQualifiedName = Funparts:FunctionName (("::" | ".") Funparts:FunctionName)*;

    Datatype implements PackageElement =
        Modifier "datatype" Name
        (KerMLRelationClause)?
        ("intersects" intersectTypes:KerMLQualifiedName ("," intersectTypes:KerMLQualifiedName)*)?
        ("{" (DocBlock|PackageElement)* "}" | ";");        

    Classifier implements PackageElement =
        Modifier
        ("classifier" | "subclassifier" | "predicate") ("all")? 
        Name (TypeMultiplicity)?
        (KerMLRelationClause)*
        ("{" (DocBlock|PackageElement)* "}"| ";");

    Feature implements PackageElement =
        Modifier
        (KerMLRelationClause)*
        ("composite")?
        ("var")?
        (shortName:KerMLQualifiedName (shortMultiplicity:TypeMultiplicity)?)?
        (KerMLRelationClause)*
        (preMultiplicity:TypeMultiplicity)?
        ("feature" | "expr" | "portion" ("feature" | "expr")?)?
        ("all")?
        ("step" | "chain")?
        ("chains")?
        (":>>" | "redefines")?
        (name:KerMLQualifiedName? (TypeMultiplicity)?)? 
        (KerMLRelationClause)*
        (":" type:KerMLQualifiedName)?
        (TypeMultiplicity
            |"ordered"
            |"nonunique"
            | KerMLRelationClause)*
        ( ("=" | "default") Expression )?
        (FeatureInit | ";");
        
    Multiplicity implements PackageElement =
        "multiplicity"
        KerMLQualifiedName
        TypeMultiplicity
        ("{" (DocBlock)? "}");

    Function implements PackageElement =
        Modifier
        "function" FunctionName
        ( (":>" | "specializes") superFunctions:(KerMLQualifiedFunctionName || ",")+ )?
        ("{" 
            ( Feature | Function | IfElse | Invariant | DocBlock | Connector | Step  
            | Succession | FunctionReturn | FunctionParameter  )* ("chain")? 
        "}" | ";");

    Struct implements PackageElement =
        Modifier
        "struct" ("all")? Name (TypeMultiplicity | KerMLSpecialization |KerMLIntersection | KerMLDisjoint)*
        ((Name (TypeMultiplicity)?) ("," Name (TypeMultiplicity)*)*)?
        ("{" 
            (DocBlock |StructVar | StructInv | CommentElement | PackageElement |Feature | Step)* 
        "}" | ";");

    Behavior implements PackageElement =
        Modifier ("behavior" | "interaction") ("all")? Name 
        (KerMLRelationClause)*
        ("{" 
            (Feature | Function | IfElse | Invariant | DocBlock | Connector 
            | Step | Succession | Binding | FunctionReturn | FunctionParameter)* ("chain")? 
        "}" | ";");        

    StructVar =
        Modifier Name ":" (Name)? (":>>" Name)? ";";

    StructInv =
        Modifier "inv" MCQualifiedName? "{" (DocBlock|PackageElement|Expression)* "}";

    Test implements PackageElement = 
        Expression "implies" Expression;

    FunctionParameter implements PackageElement =
        Modifier
        (KerMLRedefinition)?
        (FunctionName)* 
        (":" type:KerMLQualifiedName)? 
        ( TypeMultiplicity | "ordered" | "nonunique" | KerMLSubsetting 
            | KerMLChains | KerMLRedefinition | "chain" )*
        (("="|"default") Expression)?
        ( (FunctionBlock)+ (";")? | ";" ) ;

    FunctionBlock = "{"( PackageElement | DocBlock | Expression | ";")* "}";

    FunctionReturn implements PackageElement=
        "return" (Name)? (":" type:KerMLQualifiedName)? 
        ( TypeMultiplicity | "ordered" | "nonunique" | KerMLSubsetting | KerMLChains | KerMLRedefinition | "chain" )*
        ( ("=" | "default") Expression )? 
        (FeatureBlock | ";") ;

    FunctionCall = (KerMLQualifiedFunctionName? "(" (Expression ("," Expression)*)?")");

    KerMLAsExpression implements Expression <150> =
        left:Expression "as" right:KerMLQualifiedName;

    FunctionName = Name | EscapedName | SpecialName;

    SpecialName = "test" | "expr" | "thenValue"| "null";

    token EscapedName = "\'"(Name | "==" | "!=" | "===" | "[" | "!==" | "#" | "," | "@" | "@@" | "|" 
    | "&" | "array#" | "+" | "-" | "*" | "/" | "**" | "^" | "." | "??" | "%" | "~" | "<" | ">"
    | "<=" | ">=" | "..")+"\'";

    KerMLQualifiedFunctionName = FunctionName ("::" FunctionName)*;

    interface FeatureInit;

    FeatureBlock implements FeatureInit = "{" (DocBlock|PackageElement)* "}";

    TypeMultiplicity = "[" min:Bound ".." max:Bound "]" | "[" exact:Bound "]";

    Bound = NatLiteral | "*" | Name;

    IfElse =
        "if" Expression "?" Expression "else" Expression;

    IfElseElement =
          Name | NatLiteral | "null" | "in" | "or" | "and" | "as"
        | "#" | "*" | "+" | "-" | "." | "," | ":" | "=" | "==" | "!=" | "<" | ">" | "<=" | ">=" | "!" | "->" | ".."
        | "(" (IfElseElement | ";")* ")"
        | "{" (IfElseElement | ";")* "}"
        | "[" (IfElseElement | ";")* "]" ;

    Invariant implements PackageElement =
        Modifier "inv" MCQualifiedName? "{" (DocBlock | PackageElement | Expression)* "}";

    Connector implements PackageElement = 
        Modifier
        "connector" ("all")? Name?
        (KerMLRelationClause)*
        (":" type:KerMLQualifiedName)?
        (TypeMultiplicity)?
        (KerMLRelationClause)*
        (
            ("from")? (TypeMultiplicity)? Expression ("references" fromRef:KerMLQualifiedName)?
            "to" (TypeMultiplicity)? Expression ("references" toRef:KerMLQualifiedName)?
        )?
        ("{" (DocBlock | PackageElement)* "}"|";") ;
    
    Step implements PackageElement =
        Modifier
        ("composite")? 
        (shortName:KerMLQualifiedName (shortMultiplicity:TypeMultiplicity)?)?
        (KerMLRelationClause)*
        (preMultiplicity:TypeMultiplicity)?
        "step" 
        (":>>" | "redefines")?
        (name:KerMLQualifiedName)? 
        (KerMLRelationClause)*
        (":" type:KerMLQualifiedName)?
        ( "ordered" | "nonunique" | KerMLRelationClause)*
        ( ("=" | "default") Expression )?
        (FeatureBlock | ";") ;

    Metaclass implements PackageElement =
        Modifier
        "metaclass" Name
        (KerMLSpecialization)?
        ("{" (DocBlock | PackageElement)* "}" | ";");

    Association implements PackageElement =
        Modifier
        "assoc" ("struct")? ("all")? Name (TypeMultiplicity)?
        (KerMLRelationClause)*
        ("{" (DocBlock | PackageElement)* "}" | ";");

    CommentElement implements PackageElement =
        "comment" (KerMLQualifiedName)? 
        ("about" KerMLQualifiedName ("," KerMLQualifiedName)*)? 
        ("{" (DocBlock | PackageElement)* "}" | ";")? ;

    StepProperty = 
        Modifier Name ("=" Expression)? ";" ;

    Succession implements PackageElement =
        Modifier "succession" ("all")? (Name (TypeMultiplicity)?)?() 
        (("first")? (TypeMultiplicity)? left:Expression)? 
        "then" 
        (TypeMultiplicity)? right:Expression 
        ("{" (DocBlock | PackageElement)* "}" | ";") ;

    Binding implements PackageElement =
        Modifier "binding" (Name (TypeMultiplicity)?("of")?)? (TypeMultiplicity)? left:Expression "=" 
        (TypeMultiplicity)? right:Expression 
        ("{" (DocBlock | PackageElement)*"}" |";") ;

    Alias implements PackageElement =
        Modifier "alias" EscapedName "for" KerMLQualifiedName ";" ;

    NamelessRedefinitionFeature implements PackageElement =
        Modifier "feature" KerMLRedefinition ";" ;

    ShorthandRedefinition implements PackageElement =
        ":>>" Name "=" Expression ";" ;

    Classification implements PackageElement =
        Modifier
        "class" ("all")? Name (TypeMultiplicity)?
        (KerMLRelationClause)*
        ("{" (DocBlock | PackageElement)* "}" | ";");

    BodyRelationStatement implements PackageElement =
        Modifier 
        ("specializes" | ":>" | "subsets" | "redefines" | ":>>" | "chains" 
        | "crosses" | "intersects" | "unions" | "inverse" ("of")? | "disjoint" ("from")?)
        targets:(KerMLQualifiedName || ",")+ 
        ("{" (DocBlock | PackageElement| Expression)* "}" | ";") ;

    interface KerMLRelationClause;

    KerMLSpecialization implements KerMLRelationClause =
        (":>" | "specializes") specialized:(KerMLQualifiedName || ",")+ ;

    KerMLSubsetting implements KerMLRelationClause = 
        (":>" | "subsets") subset:(KerMLQualifiedName || ",")+ ;
    
    KerMLRedefinition implements KerMLRelationClause = 
        (":>>" | "redefines") redefined:(KerMLQualifiedName || ",")+ ;
    
    KerMLChains implements KerMLRelationClause = 
        (":>" | "chains") chained:(KerMLQualifiedName || ",")+ ;

    KerMLCrossing implements KerMLRelationClause = 
        "crosses" KerMLQualifiedName ("," KerMLQualifiedName)* ;

    KerMLIntersection implements KerMLRelationClause = 
        "intersects" KerMLQualifiedName ("," KerMLQualifiedName)*;

    KerMLInverse implements KerMLRelationClause = 
        "inverse" ("of")? inverses:(KerMLQualifiedName || ",")+ ;

    KerMLUnion  implements KerMLRelationClause= 
        "unions" unioned:(KerMLQualifiedName || ",")+ ;
    
    KerMLDisjoint implements KerMLRelationClause = 
        "disjoint" "from" disjoints:(KerMLQualifiedName || ",")+ ;

    SubsetStatement implements PackageElement =
        Modifier "subset" left:KerMLQualifiedName "subsets" right:(KerMLQualifiedName || ",")+ ";" ;

    DisjointStatement implements PackageElement =
        Modifier "disjoint" left:KerMLQualifiedName "from" right:(KerMLQualifiedName || ",")+ ";" ;

    KerMLReferences implements KerMLRelationClause= 
        "references" referenced:(KerMLQualifiedName || ",")+ ;
}
